// ─────────────────────────────────────────────────────────────────────────────
// ORQUESTADOR de CelularPro: el "trigger" que encadena todo
//                                           (job en Jenkins: celularpro-orquestador)
//
//   0. Código      baja los dos repositorios (así el trigger vigila los dos)
//   1. Backend     corre el job celularpro-backend  (pruebas + SonarQube + imagen)
//   2. Frontend    corre el job celularpro-front    (pruebas + SonarQube + imagen)
//   3. Docker      levanta la app completa: base de datos, API y front
//   3b. Pruebas    Cypress (API y E2E de las funcionalidades 13, 26 a 30) contra lo desplegado en Docker
//   4. Vercel      publica la API y el front
//   5. Pruebas     Cypress contra lo publicado en Vercel (si se dan sus URLs)
//
// Cada etapa corre solo si la anterior pasó. Si el backend falla, el front ni
// se prueba; si el front falla, no se despliega nada. Nunca se publica algo
// que no pasó sus pruebas y su Quality Gate.
//
// Plugins: los mismos de los otros dos jobs (Pipeline, Git, Docker Pipeline,
// SonarQube Scanner, JUnit, Timestamper) + Credentials Binding para Vercel.
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    // Sin agente global: mientras espera a los otros jobs no ocupa un ejecutor.
    agent none

    triggers {
        // Cada ~5 minutos revisa si hay commits nuevos en el back o en el front
        // (los repositorios que se bajan en la etapa 0). Si los hay, arranca
        // la cadena sola: así se verifica todo después de cada cambio.
        pollSCM('H/5 * * * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(
            name: 'VITE_API_URL',
            defaultValue: 'http://localhost:3001/api/v1',
            description: 'URL de la API que queda grabada en el front de Docker.'
        )
        booleanParam(
            name: 'INCLUIR_UI_DE_MARIO',
            defaultValue: false,
            description: 'Correr tambien los E2E y el Gherkin de cypress/e2e y cypress/gherkin. Estan escritos para la interfaz de Mario (pagina /profile, /admin/alerts, otra ayuda) y este front no la tiene: fallan hasta que esas pantallas existan.'
        )
        booleanParam(
            name: 'DESPLEGAR_VERCEL',
            defaultValue: true,
            description: 'Publicar la API y el front en Vercel al final (necesita las credenciales de Vercel en Jenkins).'
        )
        string(
            name: 'REPO_BACKEND',
            defaultValue: 'https://github.com/Santiago-mg/Proyecto-de-aula.git',
            description: 'Repositorio del backend (Proyecto-de-aula-mario). Cámbialo por el del equipo si es otro.'
        )
        string(
            name: 'RAMA_BACKEND',
            defaultValue: 'main',
            description: 'Rama del backend que se prueba y se despliega.'
        )
        string(
            name: 'URL_FRONT_VERCEL',
            defaultValue: '',
            description: 'URL pública del front en Vercel, para las pruebas posteriores al despliegue (vacío = no se prueban).'
        )
        string(
            name: 'URL_API_VERCEL',
            defaultValue: '',
            description: 'URL pública de la API en Vercel, terminada en /api/v1.'
        )
    }

    environment {
        REPO_BACKEND = "${params.REPO_BACKEND}"
        RAMA_BACKEND = "${params.RAMA_BACKEND}"
    }

    stages {

        stage('0. Código') {
            agent any
            steps {
                // El front ya está en el workspace (aquí vive este archivo).
                // El backend se baja para que el trigger también vea sus commits.
                dir('backend') {
                    git url: env.REPO_BACKEND, branch: env.RAMA_BACKEND
                }
            }
        }

        stage('1. Backend') {
            steps {
                // Espera a que termine; si falla, esta etapa falla y la cadena
                // se detiene aquí.
                build job: 'celularpro-backend'
            }
        }

        stage('2. Frontend') {
            steps {
                build job: 'celularpro-front', parameters: [
                    string(name: 'VITE_API_URL', value: params.VITE_API_URL)
                ]
            }
        }

        stage('3. Desplegar con Docker') {
            agent {
                dockerfile {
                    filename 'Dockerfile.jenkins'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
                }
            }
            steps {
                sh '''
                    # Se baja el despliegue anterior (si lo hay) junto con su
                    # base (-v) y se levanta de nuevo desde cero:
                    # base → migraciones + seed → API → front.
                    docker compose -p celularpro down -v --remove-orphans
                    docker compose -p celularpro up -d

                    # Espera a que la API y el front estén sanos (HEALTHCHECK de
                    # cada imagen). Máximo 60 segundos por servicio.
                    for servicio in celularpro-api celularpro-front; do
                        for intento in $(seq 1 30); do
                            estado=$(docker inspect -f '{{.State.Health.Status}}' "$servicio")
                            [ "$estado" = "healthy" ] && break
                            sleep 2
                        done
                        echo "$servicio: $estado"
                        if [ "$estado" != "healthy" ]; then
                            docker logs --tail 50 "$servicio"
                            exit 1
                        fi
                    done

                    # Prueba de humo: la API responde con el catálogo que cargó el seed.
                    docker exec celularpro-api node -e "
                        fetch('http://127.0.0.1:3001/api/v1/phones')
                            .then((r) => r.json())
                            .then((j) => {
                                console.log('Celulares en el catálogo:', j.meta.total)
                                process.exit(j.meta.total > 0 ? 0 : 1)
                            })
                            .catch(() => process.exit(1))
                    "
                '''
                echo 'App en Docker → front: http://localhost:8081 · API: http://localhost:3001/api/v1'
            }
        }

        // ── Criterio 9: pruebas DESPUÉS del despliegue ─────────────────────────
        // Mismas suites que ya pasaron antes de desplegar, ahora contra la app
        // desplegada: confirman que las correcciones siguen ahí (regresión) y
        // que nada se rompió al empaquetar. Stagehand queda fuera, como pide la rúbrica.
        stage('3b. Pruebas posteriores al despliegue (Docker)') {
            agent {
                docker {
                    // Misma versión de Cypress que el proyecto (13.17.0), con el binario incluido.
                    image 'cypress/included:13.17.0'
                    // --network host: el navegador alcanza localhost:8081 y localhost:3001 del host
                    // (la URL de la API quedó grabada en el front como localhost:3001).
                    args '--network host -u root --entrypoint='
                }
            }
            environment {
                CYPRESS_BASE_URL       = 'http://localhost:8081'
                CYPRESS_API_URL        = 'http://localhost:3001/api/v1'
                CYPRESS_INSTALL_BINARY = '0'   // el binario ya viene en la imagen
            }
            steps {
                sh 'npm ci --no-audit --no-fund'
                // API: contrato, seguridad (cabeceras, 403 al banear a un admin, 429...) y regresión
                sh 'CY_SUITE=post-despliegue-api npx cypress run --spec "cypress/api/**/*.cy.ts"'
                // E2E de las funcionalidades 13, 26, 27, 28, 29 y 30 (Screenplay): 20 de interfaz
                // y 12 de API. Es un proyecto aparte, con su propio package.json. Sus direcciones
                // por defecto (front :8081, API :3001) son las del Docker recién levantado.
                dir('e2e/santiago/cypress') {
                    sh 'npm ci --no-audit --no-fund'
                    sh 'npx cypress run'
                }
                script {
                    if (params.INCLUIR_UI_DE_MARIO) {
                        // Recorridos de la interfaz de Mario y su Gherkin: ver el parámetro.
                        sh 'CY_SUITE=post-despliegue-e2e npx cypress run --spec "cypress/e2e/**/*.cy.ts"'
                        sh 'npx cypress run --config-file cypress.gherkin.config.ts'
                    }
                }
            }
            post {
                always {
                    junit testResults: 'cypress/resultados/*.xml', allowEmptyResults: true, skipMarkingBuildUnstable: true
                    archiveArtifacts artifacts: 'cypress/screenshots/**,cypress/videos/**,cypress/gherkin/reportes/**,e2e/santiago/cypress/cypress/screenshots/**', allowEmptyArchive: true
                }
            }
        }

        stage('4. Desplegar en Vercel') {
            when {
                beforeAgent true   // si no se pide Vercel, ni siquiera arma el agente
                expression { params.DESPLEGAR_VERCEL }
            }
            agent {
                dockerfile {
                    filename 'Dockerfile.jenkins'
                    args '-u root'
                }
            }
            steps {
                // Cuatro credenciales "Secret text" en Jenkins (ver DEVOPS.md).
                // withCredentials las oculta en el log.
                withCredentials([
                    string(credentialsId: 'vercel-token', variable: 'VERCEL_TOKEN'),
                    string(credentialsId: 'vercel-org-id', variable: 'VERCEL_ORG_ID'),
                    string(credentialsId: 'vercel-project-backend', variable: 'PROYECTO_BACKEND'),
                    string(credentialsId: 'vercel-project-front', variable: 'PROYECTO_FRONT')
                ]) {
                    // API: se clona el backend de main (el que se acaba de
                    // probar) en /tmp del contenedor y se publica desde ahí.
                    sh '''
                        git clone --depth 1 --branch "$RAMA_BACKEND" "$REPO_BACKEND" /tmp/backend
                        cd /tmp/backend
                        VERCEL_PROJECT_ID="$PROYECTO_BACKEND" npx --yes vercel@62.7.0 deploy --prod --yes --token "$VERCEL_TOKEN"
                    '''
                    // Front: el de este repositorio (el workspace del job).
                    sh 'VERCEL_PROJECT_ID="$PROYECTO_FRONT" npx --yes vercel@62.7.0 deploy --prod --yes --token "$VERCEL_TOKEN"'
                }
            }
        }
        stage('5. Pruebas posteriores al despliegue (Vercel)') {
            when {
                beforeAgent true
                expression { params.DESPLEGAR_VERCEL && params.URL_FRONT_VERCEL && params.URL_API_VERCEL }
            }
            agent {
                docker {
                    image 'cypress/included:13.17.0'
                    args '-u root --entrypoint='
                }
            }
            environment {
                CYPRESS_BASE_URL       = "${params.URL_FRONT_VERCEL}"
                CYPRESS_API_URL        = "${params.URL_API_VERCEL}"
                CYPRESS_INSTALL_BINARY = '0'
            }
            steps {
                sh 'npm ci --no-audit --no-fund'
                // Contrato y seguridad de la API publicada
                sh 'CY_SUITE=vercel-api npx cypress run --spec "cypress/api/**/*.cy.ts"'
                // Recorridos de las funcionalidades 13, 26 a 30 sobre lo publicado
                dir('e2e/santiago/cypress') {
                    sh 'npm ci --no-audit --no-fund'
                    sh 'E2E_FRONT_URL="$CYPRESS_BASE_URL" E2E_API_URL="$CYPRESS_API_URL" npx cypress run'
                }
                script {
                    if (params.INCLUIR_UI_DE_MARIO) {
                        sh 'CY_SUITE=vercel-e2e npx cypress run --spec "cypress/e2e/acceso.cy.ts,cypress/e2e/perfil-y-roles.cy.ts,cypress/e2e/heuristicas.cy.ts"'
                    }
                }
            }
            post {
                always {
                    junit testResults: 'cypress/resultados/*.xml', allowEmptyResults: true, skipMarkingBuildUnstable: true
                    archiveArtifacts artifacts: 'cypress/screenshots/**,cypress/videos/**,e2e/santiago/cypress/cypress/screenshots/**', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        success {
            echo 'Cadena completa: back y front probados y analizados, desplegados en Docker y Vercel, y vueltos a probar después del despliegue.'
        }
        failure {
            echo 'La cadena se detuvo. Mira qué etapa quedó en rojo: las siguientes no corrieron.'
        }
    }
}
