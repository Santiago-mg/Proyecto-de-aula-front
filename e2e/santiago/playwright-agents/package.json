{
  "name": "celularpro-playwright-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E con Playwright Test Agents (planner, generator, healer) — ESC-13 y ESC-26 a ESC-30",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "reporte": "playwright show-report reporte",
    "agentes": "playwright init-agents --loop=claude",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
