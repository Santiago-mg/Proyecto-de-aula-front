# Copia este archivo como .env y completa solo el proveedor que vayas a usar.
# El .env no se sube a git: nunca publiques una clave real.
#
# Stagehand le pide a un modelo de lenguaje que decida qué elemento tocar o
# qué dato leer. Son los mismos tres proveedores del ejemplo del profesor
# (Stagehand-E2E-AI): openai, gemini y ollama.

# Proveedor con el que corren las pruebas: openai, gemini u ollama.
# También se puede cambiar solo para una corrida:  AI_PROVIDER=gemini npm test
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Google Gemini (clave de Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# Ollama local: no necesita clave externa (ollama pull qwen2.5:7b).
# Los modelos locales pequeños suelen fallar en `observe`; ver README.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# Dónde corre CelularPro (por defecto, el docker-compose del front)
E2E_FRONT_URL=http://localhost:8081
E2E_API_URL=http://localhost:3001/api/v1
E2E_ADMIN_EMAIL=admin@celularpro.co
E2E_ADMIN_PASSWORD=admin1234

# Milisegundos máximos por llamada a la IA (por defecto 120000; con Ollama, 240000)
# LLAMADA_TIMEOUT_MS=120000

# Pausa (ms) entre llamadas a la IA. Por defecto 0: si el proveedor limita (Gemini gratis: ~5 por
# minuto) la prueba espera lo que él indique y reintenta. Si pasa muy seguido, probar:
# LLAMADA_PAUSA_MS=6000

# false = ver el navegador mientras prueba
HEADLESS=true
# debug = más detalle en la consola
STAGEHAND_LOG_LEVEL=info

# Solo si Stagehand no encuentra Chrome solo
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
