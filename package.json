{
  "name": "celular-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regresion": "npm run test:regresion:santiago && npm run test:regresion:mario",
    "test:regresion:santiago": "node test/regresion/santiago/ejecutar.mjs",
    "test:regresion:mario": "vitest run test/regresion/mario",
    "test:regresion:mario:pendiente": "vitest run --config vitest.pendiente.config.ts",
    "test:pendiente-qa": "vitest run --config vitest.pendiente-qa.config.ts",
    "test:regresion:funcional": "vitest run test/regresion/santiago/regression-testing",
    "test:regresion:api": "vitest run test/regresion/santiago/api-testing",
    "test:regresion:performance": "vitest run test/regresion/santiago/performance-testing",
    "test:regresion:seguridad": "vitest run test/regresion/santiago/security-testing",
    "sonar": "npm run test:coverage && npx --yes sonarqube-scanner",
    "docker:build": "docker build --build-arg VITE_API_URL=${VITE_API_URL:-http://localhost:3001/api/v1} -t celularpro-front:latest .",
    "docker:run": "docker run --rm -p 8080:80 --name celularpro-front celularpro-front:latest",
    "cy:component": "cypress run --component",
    "cy:api": "cypress run --spec \"cypress/api/**/*.cy.ts\"",
    "cy:e2e": "cypress run --spec \"cypress/e2e/**/*.cy.ts\"",
    "cy:open": "cypress open",
    "rp:simulador": "node reportportal/servidor-simulado.mjs 8089",
    "rp:servidor": "docker compose -f reportportal/docker-compose.yml -p reportportal --profile core --profile analyzer up -d",
    "rp:serenity": "node reportportal/importar-junit.mjs e2e/serenityjs/reports/junit-serenity.xml serenity \"Serenity/JS + Cucumber (Screenplay)\"",
    "rp:katalon": "node e2e/katalon/a-junit.cjs && node reportportal/importar-junit.mjs e2e/katalon/evidencia/junit-katalon.xml katalon \"Katalon (Selenese)\"",
    "rp:momentic": "node reportportal/importar-junit.mjs e2e/momentic/reports/junit.xml momentic \"Momentic (IA)\"",
    "nexus:listar": "npm --prefix e2e/autify-nexus run listar",
    "nexus:test": "npm --prefix e2e/autify-nexus test",
    "momentic:lint": "npm --prefix e2e/momentic run lint",
    "momentic:test": "npm --prefix e2e/momentic test",
    "stagehand:typecheck": "npm --prefix e2e/stagehand run typecheck",
    "stagehand:test": "npm --prefix e2e/stagehand test",
    "rp:stagehand": "node reportportal/importar-junit.mjs e2e/stagehand/reports/junit-stagehand.xml stagehand \"Stagehand (act, observe, extract)\"",
    "cy:gherkin": "cypress run --config-file cypress.gherkin.config.ts",
    "cy:gherkin:abrir": "cypress open --config-file cypress.gherkin.config.ts",
    "cy:accesibilidad": "cypress run --spec \"cypress/e2e/accesibilidad.cy.ts\"",
    "gherkin:verificar": "node scripts/verificar-gherkin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "axios": "^1.7.7",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "23.2.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@reportportal/agent-js-cypress": "5.5.4",
    "@reportportal/agent-js-vitest": "5.1.1",
    "@reportportal/client-javascript": "5.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/chai": "^4.3.20",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^1.6.1",
    "axe-core": "^4.14.0",
    "chai": "^4.5.0",
    "cypress": "^13.17.0",
    "esbuild": "0.21.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
  }
}
